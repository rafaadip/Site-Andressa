# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Cada área só é exigida por quem a usa: sem Google/Resend o site sobe e
# agenda — ver docs/OPERACAO.md.

# ── Banco (obrigatório) ──────────────────────────────────
# Host remoto exige TLS: sem `sslmode`, o site cifra sozinho; `disable`,
# `allow` e `prefer` são recusados (docs/SEGURANCA.md, SEC-03).
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?sslmode=require"
# Conexão direta (sem pooler): usada pelas migrations.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/postgres?sslmode=require"
# PEM da CA do Supabase (Settings → Database → SSL). Com ele, o certificado
# do banco é VERIFICADO (sem ele, só cifrado). Numa linha só, com \n.
DATABASE_CA_CERT=""
# Usado só pelos testes de integração/E2E; deixe vazio para pulá-los.
DATABASE_URL_TEST=""

# ── Segurança (obrigatório) ──────────────────────────────
TOKEN_SALT=""                       # openssl rand -hex 16 — NUNCA trocar depois do go-live (invalida os links)

# ── Público ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Agendamento ──────────────────────────────────────────
# Sem a agenda do Google conectada, o site oferta horários SEM saber dos
# plantões da médica. Em produção isso exige decisão consciente:
# AGENDAMENTO_SEM_GOOGLE="aceito". Sem isso (e sem Google), /agendar cai no WhatsApp.
AGENDAMENTO_SEM_GOOGLE=""

# ── Painel /admin ────────────────────────────────────────
AUTH_SECRET=""                      # openssl rand -base64 32 — girar derruba todas as sessões
ADMIN_EMAIL="andressa15correia@gmail.com"   # a ÚNICA conta que entra (em preview: uma conta de teste)

# ── Google (login do painel + agenda) ────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_ID="primary"
GOOGLE_WEBHOOK_TOKEN=""             # openssl rand -hex 16
ENCRYPTION_KEY=""                   # openssl rand -base64 32 (32 bytes) — cifra o refresh token
# Fora da produção, o sistema recusa conectar esta conta (agenda real).
AGENDA_REAL_EMAIL="andressa15correia@gmail.com"

# ── E-mail (Resend) ──────────────────────────────────────
RESEND_API_KEY=""                   # re_...
EMAIL_FROM="Dra. Andressa Correia <contato@draandressacorreia.com.br>"
EMAIL_REPLY_TO="andressa15correia@gmail.com"
RESEND_WEBHOOK_SECRET=""            # whsec_... (webhook de bounce: /api/webhooks/resend)

# ── Cron (Vercel envia sozinha como Bearer) ──────────────
CRON_SECRET=""                      # openssl rand -hex 16 — sem ele as rotas de cron ficam FECHADAS

# ── Observabilidade e analytics (opcionais) ──────────────
SENTRY_DSN=""                       # https://<chave>@<host>/<projeto> — erros sem dado pessoal
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""     # ex.: draandressacorreia.com.br — analytics sem cookie
